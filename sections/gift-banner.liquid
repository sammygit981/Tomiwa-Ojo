{{ 'gift-banner.css' | asset_url | stylesheet_tag }}

<section class="gift-banner">

  <div class="gift-banner__main">

    {%- comment -%}
      Illustration artwork.

      The top illustration occupies the upper portion of the banner.
      The second illustration is anchored to the lower-right corner.
      Both are decorative and therefore hidden from screen readers.
    {%- endcomment -%}

    <div class="gift-banner__art" aria-hidden="true">

      <img
        src="{{ 'gift-illustration-top.svg' | asset_url }}"
        alt=""
        class="gift-banner__image gift-banner__image--top"
        loading="eager"
        width="1440"
        height="390"
      >

      <img
        src="{{ 'gift-illustration-bottom.svg' | asset_url }}"
        alt=""
        class="gift-banner__image gift-banner__image--bottom"
        loading="eager"
        width="890"
        height="402"
      >

    </div>


    {%- comment -%}
      Gift Guide content.

      The heading, description and CTA remain in the lower-left
      portion of the desktop banner.
    {%- endcomment -%}

    <div class="gift-banner__content">

      <h1
        id="gift-banner-heading-{{ section.id }}"
        class="gift-banner__heading"
      >
        {{ section.settings.heading }}
      </h1>

      <div class="gift-banner__description">
        {{ section.settings.description }}
      </div>

      <a
        href="{{ section.settings.button_link | default: '#' }}"
        class="gift-banner__button"
      >
        <span class="gift-banner__button-label">
          {{ section.settings.button_text }}
        </span>

        <span
          class="gift-banner__arrow"
          aria-hidden="true"
        >
          <span></span>
        </span>
      </a>

    </div>

  </div>


  {%- comment -%}
    Sustainable message strip.

    This is part of the banner composition and sits immediately
    below the main illustration area.
  {%- endcomment -%}

  <div class="gift-banner__sustainable">
    SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL
  </div>

</section>


{% schema %}
{
  "name": "Gift Banner",
  "tag": "section",
  "class": "section-gift-banner",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Gift Guide"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Gift Banner"
    }
  ]
}
{% endschema %}